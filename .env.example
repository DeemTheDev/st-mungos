# Copy to .env.local — server-side only, never NEXT_PUBLIC_ prefixed.
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=          # e.g. southafricanorth

# TTS voice slots — optional, all default to the en-ZA pair. Changing these in
# Vercel swaps the voices on the next token fetch; no redeploy. List what the
# region actually offers with `pnpm voices:list`.
#
# PRECEDENCE for the PATIENT voice (highest first):
#   1. VOICE_PATIENT_F / VOICE_PATIENT_M  — a hard pin. Set one and the
#      station's patient-voice dropdown is disabled for that sex.
#   2. her dropdown choice (localStorage "st-mungos:patient-voice")
#   3. "Random each station" (the default) — picked deterministically from the
#      pool below by hashing the session id, so it is stable within a station
#      and differs between stations.
VOICE_PATIENT_F=              # unset = student picks; default pool below
VOICE_PATIENT_M=              # unset = student picks; default pool below
VOICE_EXAMINER=               # default: the opposite en-ZA voice of the patient

# Selectable patient voices, comma-separated. Unset = the shipped defaults
# (all verified present in eastus — see docs/ARCHITECTURE.md §8).
VOICE_PATIENT_POOL_F=         # default: en-ZA-LeahNeural,en-GB-Sonia:DragonHDLatestNeural,en-GB-Ada:DragonHDLatestNeural,en-KE-AsiliaNeural,en-NG-EzinneNeural,en-TZ-ImaniNeural
VOICE_PATIENT_POOL_M=         # default: en-ZA-LukeNeural,en-GB-Ollie:DragonHDLatestNeural,en-GB-Ryan:DragonHDLatestNeural,en-KE-ChilembaNeural,en-NG-AbeoNeural,en-TZ-ElimuNeural
APP_ACCESS_PASSWORD=          # the simple gate for the two allowed humans

# Supabase (dedicated St Mungo's project — NOT the Teapot's)
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # sb_secret_... — server routes only

# Flashcards (docs/FLASHCARDS.md). Optional: YYYY-MM-DD — when set, FSRS cram
# mode caps every scheduled review so due dates never land after the exam.
EXAM_DATE=

# Where sessions, flashcards AND the library (uploaded guides, KB topics, cases)
# are stored: file | supabase. Default file — the whole app runs on disk with
# zero services. Production MUST be supabase: Vercel's filesystem is read-only
# and ephemeral, so file mode there loses everything and cannot approve a case.
STORE=

# Library spend guardrails (Phase 6). The upload → distil → generate pipeline
# can spend money with nobody watching, so these are HARD stops checked BEFORE
# every model call, not warnings after it. A hit returns HTTP 402 and the UI
# shows a calm notice — the cap did its job. A non-numeric or <=0 value is
# ignored with a warning rather than read as "unlimited".
LIBRARY_JOB_BUDGET_USD=       # default 2.00  — per upload/generation job
LIBRARY_MONTH_BUDGET_USD=     # default 10.00 — everything, month to date
